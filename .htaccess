Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct access to internal folders
  RewriteRule ^(config|data|includes)(/|$) - [F,L]

  # Serve real files/folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /corporate, /social
  RewriteRule ^(corporate|social)/?$ category.php?category=$1 [L,QSA]

  # /corporate/research-and-strategy, /social/csr-solutions
  RewriteRule ^(corporate|social)/([a-z0-9-]+)/?$ service.php?category=$1&slug=$2 [L,QSA]

  RewriteRule ^ 404.php [L]
</IfModule>


<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
